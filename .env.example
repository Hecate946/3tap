# Local development requires no env file: `npm run dev` starts local Supabase.
#
# PRODUCTION RUNTIME (Cloudflare Worker -> Settings -> Variables & Secrets)
# SUPABASE_URL can be a normal variable.
# SUPABASE_SERVICE_ROLE_KEY must be a secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY

# PRODUCTION BUILD ONLY (Cloudflare Builds -> Build variables & secrets)
# Optional but recommended: lets every GitHub push apply pending migrations.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@HOST:5432/postgres
