# Production only. Local development is configured automatically by `npm run dev`.
# Add these to Vercel -> Project Settings -> Environment Variables -> Production.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY

# Supabase -> Connect -> Postgres connection string.
# Use the Session Pooler connection string if the direct connection is not reachable.
# This is used only during production builds to apply pending migrations.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@HOST:5432/postgres
