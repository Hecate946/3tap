{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3tap",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "SUPABASE_URL": "https://zxglxdnbkxlghssjppjh.supabase.co",
    "APP_ORIGIN": "https://3tap.cc",
    "RESET_EMAIL_FROM": "3tap <reset@3tap.cc>"
  },
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
